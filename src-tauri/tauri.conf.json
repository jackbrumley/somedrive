{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "somedrive",
  "version": "0.4.3",
  "identifier": "info.brumley.somedrive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SomeDrive",
        "width": 980,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "desktopTemplate": "packaging/bundler-stub.desktop.hbs",
        "files": {
          "/usr/share/applications/info.brumley.somedrive.desktop": "packaging/info.brumley.somedrive.desktop"
        }
      },
      "rpm": {
        "desktopTemplate": "packaging/bundler-stub.desktop.hbs",
        "files": {
          "/usr/share/applications/info.brumley.somedrive.desktop": "packaging/info.brumley.somedrive.desktop"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/applications/somedrive.desktop": "packaging/info.brumley.somedrive.desktop"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
