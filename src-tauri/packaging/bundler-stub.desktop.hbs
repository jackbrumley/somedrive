[Desktop Entry]
# Tauri's bundler always generates a desktop file named after productName,
# which cannot match the info.brumley.somedrive app ID. The real entry ships
# explicitly as info.brumley.somedrive.desktop (bundle.linux.*.files); this
# generated copy is Hidden so it never appears as a second launcher.
Type=Application
Name=SomeDrive
Exec={{exec}}
Icon={{icon}}
Categories={{categories}}
Hidden=true
