{
  "name": "somedrive",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:structure": "node ./scripts/check-file-lines.mjs",
    "check:sync-status-writes": "node ./scripts/check-sync-status-writes.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "icons:generate": "npm run tauri -- icon docs/logo.svg",
    "tauri": "tauri",
    "tauri:dev": "npm run tauri -- dev",
    "tauri:build": "npm run tauri -- build",
    "release:linux": "node scripts/build-linux-release.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:notes": "node scripts/release-notes-template.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:promote": "node scripts/promote-release.mjs"
  },
  "dependencies": {
    "@tabler/icons-preact": "^3.41.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "preact": "^10.28.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.1"
  },
  "license": "AGPL-3.0-only"
}
